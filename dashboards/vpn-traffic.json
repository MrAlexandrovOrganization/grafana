{
  "uid": "vpn-traffic",
  "title": "VPN и Telegram-прокси — трафик",
  "description": "Расход относится к конфигу, даже если ссылкой пользуются несколько людей. Upload — от клиента, download — к клиенту. Скорость усредняется по окну rate (минимум четыре опроса). Total хранится в backend и переживает рестарты; proxy total начинается с включения нового учёта. Период использует Prometheus increase: это оценка, история ограничена retention Prometheus (сейчас 15 дней), а при пропусках и рестартах возможна потеря хвоста. Байты клиента не включают накладные расходы двух туннелей и не равны трафику хостинга. Метрики собираются на российском входе, без повторного сложения Финляндии.",
  "tags": [
    "vpn",
    "telemt",
    "network"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "kind",
        "label": "Тип",
        "type": "custom",
        "query": "vpn,telemt",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "config",
        "label": "Конфиг",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(vpn_config_info{kind=~\"$kind\"}, config_name)",
        "query": {
          "query": "label_values(vpn_config_info{kind=~\"$kind\"}, config_name)",
          "refId": "configs"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Накопленный трафик · upload + download",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (vpn_config_traffic_bytes_total{kind=~\"$kind\"} * on (host, instance, config_id, kind) group_left(config_name) vpn_config_info{kind=~\"$kind\",config_name=~\"$config\"})",
          "legendFormat": "{{kind}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Текущая скорость · upload + download",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(vpn_config_traffic_bytes_total{kind=~\"$kind\"}[$__rate_interval]) * on (host, instance, config_id, kind) group_left(config_name) vpn_config_info{kind=~\"$kind\",config_name=~\"$config\"}) * 8",
          "legendFormat": "{{kind}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
